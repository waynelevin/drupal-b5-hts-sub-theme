<?php

/**
 * @file
 * Theme functions for the VSM theme.
 */

// Theme settings (Bootswatch theme, navbar alignment, font, tables) live in
// includes/*.theme.
foreach (glob(__DIR__ . '/includes/*.theme') as $file) {
  require_once $file;
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Settings that add CSS to the page each provide a helper, called from here
 * because a theme can only implement this hook once.
 */
function vsm_page_attachments_alter(array &$attachments): void {
  // Re-render when the theme settings change.
  $attachments['#cache']['tags'][] = 'config:vsm.settings';

  vsm_navbar_page_attachments($attachments);
  vsm_font_page_attachments($attachments);
  vsm_table_page_attachments($attachments);
}

function vsm_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
    $form['revision_information']['#access'] = FALSE;
  }

/**
 * Implements hook_preprocess_HOOK() for views_view_table. hid all table rows except first
 */
function vsm_preprocess_views_view_table(array &$variables): void {
  // "Striped tables" setting, for every Views table.
  vsm_table_preprocess_views_view_table($variables);

  static $seen = [];

  $view = $variables['view'];
  if ($view->id() !== 'registrations' || $view->current_display !== 'page_1') {
    return;
  }

  $key = spl_object_id($view);

  if (isset($seen[$key])) {
    $variables['header'] = [];
  }
  $seen[$key] = TRUE;
}

/**
 * Implements hook_preprocess_HOOK() for eventinstance_register_button.
 *
 * Recurring Events Registration gives its "Register" link Drupal's "button"
 * class, which the base theme styles as an uncoloured button. Its "a.button"
 * rule also outranks Bootstrap's colour classes, so replace "button" with a
 * primary Bootstrap button, coloured by the selected Bootswatch theme.
 */
function vsm_preprocess_eventinstance_register_button(array &$variables): void {
  $classes = array_diff($variables['attributes']['class'] ?? [], ['button']);
  // The base theme gives every .btn side margins for buttons in a row; line
  // this one up with the content instead, with some space above it.
  $variables['attributes']['class'] = array_values(array_merge($classes, ['btn', 'btn-primary', 'ms-0', 'mt-2']));
}
