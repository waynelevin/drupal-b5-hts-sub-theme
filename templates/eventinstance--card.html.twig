{% set availability = eventinstance.availability_count.value %}

<div class="p-3 rounded-3 bg-primary-subtle text-primary-emphasis">
  <h4>{{ content.title }}</h4>

  <div class="d-flex justify-content-between align-items-end gap-3">
    <div>
      {{ content.date|render|striptags|trim }}<br>
      Available {{ eventinstance.availability_count.value }} {#· Registrations {{ eventinstance.registration_count.value }}#}
    </div>

    <div>
      {% if availability <= 0 %}
        <span class="badge text-bg-warning">{{ 'Event Full'|t }}</span>
      {% else %}
        <a href="/events/{{ eventinstance.id.value }}/registrations/add" class="btn btn-primary" role="button">{{ 'Register'|t }}</a>
      {% endif %}
    </div>
  </div>
</div>